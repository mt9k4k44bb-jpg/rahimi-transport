<section class="section booking-section" id="reservations">
  <p class="eyebrow">YOUR EXPERIENCE AWAITS</p>
  <h2>Make a <em>reservation.</em></h2>
  <p class="section-intro">Send us your preferred details to begin your reservation request.</p>

  <form id="booking-form">
    <label for="guest-name">Full name</label>
    <input id="guest-name" name="name" type="text" placeholder="Your full name" required>

    <label for="guest-email">Email address</label>
    <input id="guest-email" name="email" type="email" placeholder="you@example.com" required>

    <label for="booking-type">Experience</label>
    <select id="booking-type" name="experience" required>
      <option value="">Choose an experience</option>
      <option>Restaurant dining</option>
      <option>Hotel stay</option>
      <option>Dining and hotel stay</option>
    </select>

    <label for="booking-date">Preferred date</label>
    <input id="booking-date" name="date" type="date" required>

    <label for="guest-count">Number of guests</label>
    <select id="guest-count" name="guests" required>
      <option value="">Select guests</option>
      <option>1</option>
      <option>2</option>
      <option>3</option>
      <option>4</option>
      <option>5 or more</option>
    </select>

    <label for="guest-requests">Special requests (optional)</label>
    <textarea id="guest-requests" name="requests" rows="4" placeholder="Tell us how we can make your experience special"></textarea>

    <button class="gold-button submit-button" type="submit">Send Reservation Request</button>
    <p id="form-message" role="status" aria-live="polite"></p>
    <p class="form-note">Demo form: requests are not sent to a real hotel or restaurant yet.</p>
  </form>
</section>

