
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap');

:root {
  --gold: #d6b477;
  --cream: #f6f0e6;
  --dark: #11110f;
  --panel: #1b1915;
  --muted: #b8b0a3;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  background: var(--dark);
  color: var(--cream);
  font-family: 'DM Sans', sans-serif;
  line-height: 1.7;
}

a {
  color: inherit;
  text-decoration: none;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  padding: 20px 7%;
  background: rgba(17, 17, 15, 0.96);
  border-bottom: 1px solid rgba(214, 180, 119, 0.2);
}

.logo {
  color: var(--gold);
  font-family: 'Cormorant Garamond', serif;
  font-size: 29px;
  font-weight: 600;
  letter-spacing: 4px;
  white-space: nowrap;
}

.site-header nav {
  display: flex;
  align-items: center;
  gap: 27px;
}

.site-header nav a {
  color: var(--cream);
  font-size: 12px;
  letter-spacing: 1px;
  transition: color 0.25s ease;
}

.site-header nav a:hover {
  color: var(--gold);
}

.menu-toggle {
  display: none;
  padding: 9px 12px;
  color: var(--gold);
  background: transparent;
  border: 1px solid var(--gold);
  cursor: pointer;
  font: inherit;
  font-size: 13px;
}

.hero {
  min-height: 650px;
  display: flex;
  align-items: center;
  padding: 90px 10%;
  background:
    linear-gradient(90deg, rgba(10, 10, 9, 0.92), rgba(10, 10, 9, 0.25)),
    url('https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=2000&q=90') center/cover;
}

.hero-content {
  max-width: 650px;
}

.eyebrow {
  color: var(--gold);
  font-size: 11px;
  letter-spacing: 3px;
  font-weight: 600;
  margin-bottom: 16px;
}

h1, h2, h3 {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 500;
  line-height: 1.1;
}

h1 {
  font-size: clamp(50px, 7vw, 88px);
  margin-bottom: 24px;
}

h1 em, h2 em {
  color: var(--gold);
  font-weight: 400;
}

.hero-content > p:not(.eyebrow) {
  color: #e0d8cc;
  max-width: 440px;
  margin-bottom: 32px;
}

.gold-button {
  display: inline-block;
  padding: 14px 24px;
  border: 1px solid var(--gold);
  background: var(--gold);
  color: #17140f;
  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
  cursor: pointer;
  transition: background 0.25s ease, color 0.25s ease;
}

.gold-button:hover {
  background: transparent;
  color: var(--gold);
}

.section {
  padding: 100px 7%;
  text-align: center;
}

.section h2, .experience h2 {
  font-size: clamp(38px, 5vw, 58px);
  margin-bottom: 16px;
}

.section-intro {
  max-width: 580px;
  margin: 0 auto 44px;
  color: var(--muted);
  font-size: 14px;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 25px;
  text-align: left;
}

.card {
  min-width: 0;
  overflow: hidden;
  background: var(--panel);
  border: 1px solid rgba(214, 180, 119, 0.15);
  transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
}

.card:hover {
  transform: translateY(-6px);
  border-color: var(--gold);
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
}

.card img {
  display: block;
  width: 100%;
  height: 260px;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.card:hover img {
  transform: scale(1.04);
}

.card-info {
  padding: 25px;
}

.label {
  color: var(--gold);
  font-size: 10px;
  letter-spacing: 2px;
}

.card h3 {
  margin: 10px 0;
  font-size: 30px;
}

.card p {
  color: var(--muted);
  font-size: 13px;
}

.suites-section {
  background: #171613;
}

.experience {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 50px;
  padding: 85px 10%;
  background:
    linear-gradient(rgba(15, 14, 12, 0.82), rgba(15, 14, 12, 0.9)),
    url('https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=1600&q=85') center/cover;
}

.experience > p {
  color: #ded5c7;
  max-width: 450px;
}

.booking-section {
  background: var(--dark);
}

#booking-form {
  max-width: 650px;
  margin: 0 auto;
  padding: 35px;
  background: var(--panel);
  border: 1px solid rgba(214, 180, 119, 0.25);
  text-align: left;
}

#booking-form label {
  display: block;
  margin: 18px 0 7px;
  color: var(--cream);
  font-size: 12px;
  letter-spacing: 0.5px;
}

#booking-form input,
#booking-form select,
#booking-form textarea {
  display: block;
  width: 100%;
  padding: 13px;
  color: var(--cream);
  background: #11110f;
  border: 1px solid #494136;
  border-radius: 0;
  font: inherit;
  font-size: 14px;
}

#booking-form input:focus,
#booking-form select:focus,
#booking-form textarea:focus {
  outline: 1px solid var(--gold);
  border-color: var(--gold);
}

#booking-form input[type="date"] {
  color-scheme: dark;
}

.submit-button {
  width: 100%;
  margin-top: 25px;
}

#form-message {
  margin-top: 16px;
  color: var(--gold);
  font-size: 14px;
}

.form-note {
  margin-top: 12px;
  color: var(--muted);
  font-size: 11px;
}

footer {
  padding: 45px 20px;
  text-align: center;
  background: #0b0b0a;
  border-top: 1px solid rgba(214, 180, 119, 0.2);
}

footer > p {
  color: var(--muted);
  font-size: 12px;
  margin-top: 8px;
}

.creator-credit strong {
  color: var(--gold);
  font-weight: 600;
}

button:focus-visible, a:focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: 4px;
}

@media (max-width: 850px) {
  .site-header {
    padding: 16px 5%;
  }

  .site-header nav {
    gap: 15px;
  }

  .site-header nav a {
    font-size: 11px;
  }

  .card-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero {
    min-height: 560px;
  }
}

@media (max-width: 600px) {
  .site-header {
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 14px;
  }

  .logo {
    font-size: 25px;
    letter-spacing: 3px;
  }

  .menu-toggle {
    display: inline-block;
  }

  .site-header nav {
    display: none;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    gap: 0;
  }

  .site-header nav.is-open {
    display: flex;
  }

  .site-header nav a {
    padding: 12px 0;
    border-top: 1px solid #302a22;
    font-size: 12px;
  }

  .hero {
    min-height: 540px;
    padding: 75px 7%;
    background-position: 58% center;
  }

  h1 {
    font-size: 53px;
  }

  .section {
    padding: 70px 6%;
  }

  .card-grid {
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .card img {
    height: 260px;
  }

  .card-info {
    padding: 22px;
  }

  .experience {
    grid-template-columns: 1fr;
    gap: 18px;
    padding: 65px 7%;
  }

  #booking-form {
    padding: 23px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
